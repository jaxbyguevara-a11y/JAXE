<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to API 30 and below. Cloud backup is disabled app-wide via
  android:allowBackup="false", but these rules stay explicit so that re-enabling
  backup later cannot silently ship body measurements off the device
  (AUDITORIA.md B-07).
-->
<full-backup-content>
    <exclude domain="database" path="jaxia_database" />
    <exclude domain="database" path="jaxia_database-shm" />
    <exclude domain="database" path="jaxia_database-wal" />
</full-backup-content>
