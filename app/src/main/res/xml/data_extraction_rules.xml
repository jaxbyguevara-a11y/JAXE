<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to API 31+. The avatar profile stores height, body type, sizes and
  skin tone; the closet stores purchase prices. None of it leaves the device,
  neither to Google Drive (cloud-backup) nor to a new handset (device-transfer).
  This is what makes the in-app privacy copy truthful (AUDITORIA.md B-05/B-07).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="jaxia_database" />
        <exclude domain="database" path="jaxia_database-shm" />
        <exclude domain="database" path="jaxia_database-wal" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="jaxia_database" />
        <exclude domain="database" path="jaxia_database-shm" />
        <exclude domain="database" path="jaxia_database-wal" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
